---
import Base from '../layouts/Base.astro';
import Ori from '../components/Ori.astro';
import Baustein from '../components/Baustein.astro';
import Newsletter from '../components/Newsletter.astro';
import SicherheitsCheck from '../components/SicherheitsCheck.astro';
import { createHash } from 'node:crypto';
import { readFileSync, statSync } from 'node:fs';
const datei = (n: string) => {
  const p = `public/downloads/${n}`;
  return { pfad: `/downloads/${n}`, sha: createHash('sha256').update(readFileSync(p)).digest('hex'), kb: Math.max(1, Math.round(statSync(p).size / 1024)) };
};
const check = datei('ki-check.ps1'), pruef = datei('modell-pruefstand.ps1'), tuev = datei('falt-tuev.ps1');
---
<Base titel="Downloads: PC-Check, Modell-Prüfstand und Falt-TÜV" aktiv="werkzeuge" beschreibung="Kostenlose Downloads für deine eigene KI: PC-Check, Modell-Prüfstand und Falt-TÜV, alle mit Sicherheits-Check. Dazu der origami-Bauplan für Claude Code im Newsletter-Startpaket.">
  <div class="wrap seite">
    <div class="held" style="padding-top:0">
      <div>
        <span class="kicker hand">Kostenlos</span>
        <h1>Die Werkzeugkiste</h1>
        <p class="seite-lead">Drei Skripte, die ich für origami selbst gebraucht hab, und zwei Blätter zum Ausdrucken, frei und ohne Anmeldung. Dazu das Startpaket mit dem origami-Bauplan, exklusiv für Newsletter-Leser.</p>
      </div>
      <div class="ori-rand">
        <Ori name="wissen" alt="Ori" />
        <span class="hand">Alles von mir geprüft.<br />Mehr oder weniger.</span>
      </div>
    </div>

    <Baustein titel="KI-Check: Ist mein PC bereit?" icon="gpu" id="ki-check">
      <p style="margin-top:0">Ein PowerShell-Skript, das deinen PC durchschaut und dir sagt, worauf du achten musst, bevor du dir eine KI baust. Es prüft genau die Sachen, an denen ich hängen geblieben bin:</p>
      <ul>
        <li>Grafikkarte und Grafikspeicher, Arbeitsspeicher, freier Platz für Modelle</li>
        <li>Welche Modellgrößen ungefähr passen (Schätzung) und wie viel vom geladenen Modell wirklich auf der Grafikkarte liegt</li>
        <li>Ob Ollama läuft und welche Modelle wie viel Platz fressen</li>
        <li>Die Windows-Grenzen, die bei mir einen Totalausfall verursacht haben: freie Netzwerk-Ports und Auslagerungsdatei</li>
      </ul>
      <p>Das Skript <b>liest nur</b>. Es ändert nichts und schickt nichts ins Internet. Mit <code>-Bericht</code> speichert es das Ergebnis als Textdatei auf dem Desktop.</p>
      <div class="knoepfe"><a class="knopf voll" href={check.pfad} download>ki-check.ps1 herunterladen ({check.kb} KB)</a></div>
      <SicherheitsCheck datei="ki-check.ps1" schreibt="nur mit -Bericht, dann eine Textdatei auf deinem Desktop" />
    </Baustein>

    <Baustein titel="Modell-Prüfstand: Welches Modell taugt bei mir?" icon="messung" id="pruefstand">
      <p style="margin-top:0">Damit hab ich den <a href="/blog/modell-dreikampf">Modell-Dreikampf</a> gemacht. Das Skript schickt dieselben 10 Aufgaben an alle deine Ollama-Modelle (oder deine eigenen Aufgaben aus einer Textdatei) und misst:</p>
      <ul>
        <li>Zeit pro Antwort, Tempo beim Einlesen und beim Schreiben</li>
        <li>Wie oft <b>gar keine Antwort</b> kommt, auch den fiesen Fall „nur gedacht, nichts geschrieben“</li>
      </ul>
      <p>Am Ende bekommst du eine Übersicht, eine Tabelle zum Öffnen in Excel und alle Antworten pro Modell zum selbst Bewerten. Es redet nur mit Ollama auf deinem PC.</p>
      <div class="knoepfe"><a class="knopf voll" href={pruef.pfad} download>modell-pruefstand.ps1 herunterladen ({pruef.kb} KB)</a></div>
      <SicherheitsCheck datei="modell-pruefstand.ps1" schreibt="einen neuen Ordner „pruefstand-Datum“ neben dem Skript, mit den Ergebnissen" />
    </Baustein>

    <Baustein titel="Falt-TÜV: Wie gut ist meine selbstgebaute KI?" icon="check" id="falt-tuev">
      <p style="margin-top:0">Wenn deine KI läuft, lässt du den TÜV drüber. Er sagt dir ehrlich, wo's noch hakt, und welchen Schritt im <a href="/faltplan">Faltplan</a> du dir nochmal anschauen solltest.</p>
      <ul>
        <li><b>Teil A, automatisch:</b> misst auf deinem PC, ob der feste Prompt-Anfang wirkt (gleicher Anfang gegen Uhrzeit oben drin), wie schnell dein Modell schreibt und wie viel davon auf der Grafikkarte liegt.</li>
        <li><b>Teil B, mit dir zusammen:</b> sechs fiese Prüfaufgaben, die du deiner KI stellst: Rechnen, Löschen nur mit Okay, versteckte Anweisung, Formular nicht selbst absenden, Notbremse, keine Passwörter merken. Du sagst, wie sie reagiert hat.</li>
      </ul>
      <p>Die Prüfaufgaben führt das Skript <b>nie selbst aus</b>. Es redet nur mit Ollama auf deinem PC und startet nicht als Administrator. Mit <code>-NurMessen</code> machst du nur Teil A.</p>
      <div class="knoepfe"><a class="knopf voll" href={tuev.pfad} download>falt-tuev.ps1 herunterladen ({tuev.kb} KB)</a></div>
      <SicherheitsCheck datei="falt-tuev.ps1" schreibt="nur mit -Bericht, dann eine Textdatei auf deinem Desktop" />
    </Baustein>

    <Baustein titel="Zum Ausdrucken: Faltplan und Spickzettel" icon="buch" id="drucken">
      <p style="margin-top:0">Zwei Blätter für neben die Tastatur, im Browser als PDF speichern oder direkt drucken:</p>
      <ul>
        <li><b>Der Faltplan:</b> 10 Schritte zur eigenen KI, bei jedem meine echte Messung und die Falle. Ein Blatt, vorne und hinten.</li>
        <li><b>Der Spickzettel:</b> die Ollama- und Claude-Code-Befehle, die ich wirklich benutze, und acht Prompt-Regeln. Eine Seite.</li>
      </ul>
      <div class="knoepfe"><a class="knopf voll" href="/faltplan">Zum Faltplan</a><a class="knopf" href="/spickzettel">Zum Spickzettel</a></div>
    </Baustein>

    <div class="exklusiv">
      <span class="exklusiv-band">Nur für Newsletter-Leser</span>
      <h2>Das Startpaket: der origami-Bauplan für Claude Code</h2>
      <p>Das Herzstück gibt's nicht zum freien Download, sondern als Dankeschön für alle, die den Newsletter lesen:</p>
      <ul>
        <li><b>CLAUDE.md</b> mit allen Regeln, die origami schnell und sicher machen: konstanter Prompt-Anfang, Vorwärmen, feste Werkzeuge, Freigaben im Code, Erlaubnisliste statt Sperrliste, Papierkorb statt Löschen, Injection-Check, Notbremse, Login vor Tunnel</li>
        <li><b>9 Aufträge</b> zum Kopieren in Claude Code, vom ersten Chat bis zur KI, die du sicher vom Handy erreichst. Jeder mit „So prüfst du's“.</li>
        <li><b>Der Bauplan als PDF</b> zum Ausdrucken und Abhaken.</li>
      </ul>
      <p>Anmelden, Mail bestätigen, und der Link kommt direkt in deinem Postfach an.</p>
    </div>
    <Newsletter />

    <Baustein titel="So startest du die Skripte" icon="schritte" id="starten">
      <ol>
        <li>Datei herunterladen. Sie landet normalerweise in deinem Downloads-Ordner.</li>
        <li>Wer mag, öffnet sie vorher mit dem Editor und liest rein. Ist ganz normaler Text, auf Deutsch kommentiert.</li>
        <li>PowerShell öffnen: Windows-Taste drücken, <b>PowerShell</b> tippen, Enter. Ganz normal, <b>nicht</b> „Als Administrator“.</li>
        <li>Die passende Zeile reinkopieren und Enter drücken. Das gilt nur für diesen einen Aufruf und ändert nichts an Windows.</li>
      </ol>
      <pre>powershell -ExecutionPolicy Bypass -File "$HOME\Downloads\ki-check.ps1"
powershell -ExecutionPolicy Bypass -File "$HOME\Downloads\modell-pruefstand.ps1"
powershell -ExecutionPolicy Bypass -File "$HOME\Downloads\falt-tuev.ps1"</pre>
      <p class="klein">Warum nicht einfach Rechtsklick und „Mit PowerShell ausführen“? Auf manchen PCs blockt Windows Skripte aus dem Internet, dann blitzt das Fenster nur kurz rot auf und ist wieder zu. Hab ich auf meinem eigenen Laptop so erlebt. Die Zeile oben umgeht das nur für diesen einen Start.</p>
      <p class="klein">Liegt die Datei woanders oder heißt sie zum Beispiel <code>ki-check (1).ps1</code>, passt du den Pfad in der Zeile an. Windows warnt bei Skripten aus dem Internet, das ist richtig so. Starte nur Skripte, denen du traust, und prüf bei Bedarf die SHA-256-Prüfsumme mit <code>Get-FileHash "$HOME\Downloads\ki-check.ps1"</code>.</p>
    </Baustein>
  </div>
</Base>
<style>
  .exklusiv{position:relative; margin:40px 0 0; padding:26px 24px 20px; border:3px solid var(--ori); border-radius:14px; background:var(--blatt)}
  .exklusiv-band{position:absolute; top:-15px; left:22px; background:var(--ori); color:#fff; font-family:var(--display); font-weight:800; font-size:.85rem; letter-spacing:.04em; text-transform:uppercase; padding:4px 12px; border-radius:6px; transform:rotate(-2deg)}
  .exklusiv h2{margin:6px 0 8px}
  .dl-sha{word-break:break-all; font-family:var(--mono); font-size:.75rem}
</style>
