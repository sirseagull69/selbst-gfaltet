---
import Base from '../../layouts/Base.astro';
import Ori from '../../components/Ori.astro';
import ArtikelListe from '../../components/ArtikelListe.astro';
import { getCollection } from 'astro:content';
const artikel = (await getCollection('artikel')).sort((a, b) => +b.data.datum - +a.data.datum || a.data.titel.localeCompare(b.data.titel));
---
<Base titel="Blog: Eigene KI bauen, messen, absichern" aktiv="blog" beschreibung="Anleitungen, Messungen und Pannen rund um die eigene KI auf dem eigenen PC. Mit Schaubildern, echten Zahlen und Checklisten zum Abhaken.">
  <div class="wrap seite">
    <div class="held" style="padding:0 0 24px">
      <div>
        <span class="kicker">Alles aus der Werkstatt</span>
        <h1>Blog</h1>
        <p class="lead">Anleitungen, Messungen und Pannen rund um eigene KI. Jeder Artikel mit Schaubild oder Schritten und einer Checkliste zum Abhaken.</p>
      </div>
      <div class="ori-rand"><Ori name="liest" alt="Ori liest" /><span class="hand">Ich hab alle gelesen.<br />Zweimal.</span></div>
    </div>
    <ArtikelListe artikel={artikel} />
  </div>
</Base>
