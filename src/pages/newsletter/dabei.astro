---
import Base from '../../layouts/Base.astro';
import Ori from '../../components/Ori.astro';
---
<Base titel="Du bist dabei" beschreibung="Deine Anmeldung zum Newsletter ist bestätigt.">
  <div class="wrap seite">
    <div class="held" style="padding-top:0">
      <div>
        <span class="kicker hand">Newsletter</span>
        <h1>Du bist dabei.</h1>
        <p class="lead">Danke! Ab jetzt bekommst du eine Mail, wenn ein neuer Artikel erscheint. Nicht öfter, kein Werbekram. Abmelden geht jederzeit mit einem Klick unten in jeder Mail.</p>
        <h2 style="margin-top:28px">Dein Startpaket ist unterwegs</h2>
        <p class="lead">Schau in dein Postfach. In der Willkommens-Mail steckt der Link zum <b>origami-Bauplan für Claude Code</b>: eine fertige CLAUDE.md mit allen Regeln plus 9 Aufträge zum Nachbauen. Den gibt's nur für Newsletter-Leser.</p>
        <div class="knoepfe"><a class="knopf voll" href="/anleitungen">Faltanleitung aussuchen</a><a class="knopf" href="/downloads">Die freien Downloads</a></div>
      </div>
      <div class="ori-rand">
        <Ori name="triumph" alt="Ori jubelt" />
        <span class="hand">Willkommen im Club.<br />Ich bin die Vorsitzende.</span>
      </div>
    </div>
  </div>
</Base>
