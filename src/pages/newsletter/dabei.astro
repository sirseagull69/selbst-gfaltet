---
import Base from '../../layouts/Base.astro';
import Ori from '../../components/Ori.astro';
---
<Base titel="Du bist dabei" beschreibung="Deine Anmeldung zum Newsletter ist bestätigt.">
  <div class="wrap seite">
    <div class="held" style="padding-top:0">
      <div>
        <span class="kicker hand">Newsletter</span>
        <h1>Du bist dabei.</h1>
        <p class="lead">Danke! Ab jetzt bekommst du eine Mail, wenn ein neuer Artikel erscheint. Nicht öfter, kein Werbekram. Abmelden geht jederzeit mit einem Klick unten in jeder Mail.</p>
        <h2 style="margin-top:28px">Dein Startpaket</h2>
        <p class="lead">Als Dankeschön, zum Direkt-Loslegen:</p>
        <ul class="lead">
          <li><a href="/downloads/origami-bauplan.zip" download>origami-Bauplan für Claude Code</a>: CLAUDE.md mit allen Regeln plus 9 Aufträge zum Nachbauen</li>
          <li><a href="/downloads/ki-check.ps1" download>KI-Check</a>: prüft, ob dein PC bereit ist</li>
          <li><a href="/faltplan">Der Faltplan</a>: 10 Schritte, 10 Fallen, zum Ausdrucken</li>
        </ul>
        <div class="knoepfe"><a class="knopf voll" href="/lernwege">Lernweg aussuchen</a><a class="knopf" href="/downloads">Alle Downloads</a></div>
      </div>
      <div class="ori-rand">
        <Ori name="triumph" alt="Ori jubelt" />
        <span class="hand">Willkommen im Club.<br />Ich bin die Vorsitzende.</span>
      </div>
    </div>
  </div>
</Base>
