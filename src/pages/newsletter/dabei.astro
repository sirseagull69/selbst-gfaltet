---
import Base from '../../layouts/Base.astro';
import Ori from '../../components/Ori.astro';
---
<Base titel="Du bist dabei" beschreibung="Deine Anmeldung zum Newsletter ist bestätigt.">
  <div class="wrap seite">
    <div class="held" style="padding-top:0">
      <div>
        <span class="kicker hand">Newsletter</span>
        <h1>Du bist dabei.</h1>
        <p class="lead">Danke! Ab jetzt bekommst du eine Mail, wenn ein neuer Artikel erscheint. Nicht öfter, kein Werbekram. Abmelden geht jederzeit mit einem Klick unten in jeder Mail.</p>
        <div class="knoepfe"><a class="knopf voll" href="/lernwege">Lernweg aussuchen</a><a class="knopf" href="/faltplan">Zum Faltplan</a></div>
      </div>
      <div class="ori-rand">
        <Ori name="triumph" alt="Ori jubelt" />
        <span class="hand">Willkommen im Club.<br />Ich bin die Vorsitzende.</span>
      </div>
    </div>
  </div>
</Base>
