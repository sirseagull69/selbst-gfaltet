---
import Base from '../layouts/Base.astro';
import PapierDeko from '../components/papier/PapierDeko.astro';
import PapierLogo from '../components/papier/PapierLogo.astro';
import PapierFuss from '../components/papier/PapierFuss.astro';
import '../styles/papier.css';
// [Titel, Was du tust, Meine Zahl, Die Falle]
const SCHRITTE = [
  ['Grafikkarte ehrlich prüfen', 'Schau, wie viel Speicher (VRAM) deine Grafikkarte hat. Im Rechner „Passt das auf meinen PC?“ siehst du, was ungefähr passt.', 'Gemma 4 26B belegt bei mir rund 17 GB. Auf der 8-GB-Karte liegen ca. 7,6 GB, der Rest im Arbeitsspeicher.', 'Passt nicht alles auf die Karte, ist vor allem das Einlesen langer Texte zäh. Das Schreiben geht trotzdem flott.'],
  ['Modelle mit eigenen Aufgaben testen', 'Ollama installieren, zwei, drei Modelle laden und mit zehn Aufgaben testen, die du wirklich stellen würdest. Zeit und Ergebnis aufschreiben.', 'Gemma 26B: 81 Punkte, 54 s pro Aufgabe. Das größere Qwen3.6: 76 Punkte, aber dreimal so langsam.', 'Zähl, wie oft gar keine Antwort kommt. Das kleine Qwen3.5 war schnell, hat aber 6 von 10 Mal nichts geschrieben.'],
  ['Den Anfang des Prompts nie ändern', 'Anweisungen und Werkzeugliste bleiben bei jeder Anfrage exakt gleich. Uhrzeit, Datum und Wechselndes hängst du hinten an die Nachricht.', 'Vorher bis ca. 107 s bis zur Antwort, nachher 8 bis 12 s.', 'Schon eine Uhrzeit oben in den Anweisungen reicht, und das Modell liest jedes Mal alles neu ein.'],
  ['Vorwärmen', 'Nach dem Start und beim Öffnen der App schickt deine Oberfläche eine leere Probe-Anfrage mit genau deinem Prompt. Dann ist der Anfang schon eingelesen, wenn du tippst.', 'Erste Frage 9 s statt 39 s.', 'Nicht während einer laufenden Antwort vorwärmen, und nicht ständig. Bei mir höchstens alle 2 Minuten.'],
  ['Feste Werkzeuge statt Webseiten', 'Für Dinge, die oft gefragt werden (Wetter, Bahn, Rechnen), ein eigenes Werkzeug bauen, das eine fertige kleine Antwort liefert.', 'Wetterfrage: fast 4 Minuten, mit eigenem Werkzeug 14 Sekunden.', 'Lässt du das Modell ganze Webseiten lesen, verheddert es sich und braucht ewig. Und rechnen sollte nie das Modell, immer der Code.'],
  ['Aufgaben aufteilen', 'Alltagssachen bleiben lokal, Schweres geht an ein Cloud-Modell. Entscheiden lässt du das eine einfache Wortliste, keine KI.', 'Bei mir geht alles über 700 Zeichen, Code und Recherche direkt an Claude.', 'Im Vergleich war Claude in allen 7 Aufgaben besser. Lokal lohnt sich für Alltag und private Daten, nicht für alles.'],
  ['Notbremse einbauen', 'Dein Code zählt mit: Fehler, wiederholte Aktionen, Schritte ohne Ergebnis. Bei einer festen Grenze wird abgebrochen oder abgegeben.', 'Bei mir: 3 Fehler, 3-mal dieselbe Aktion oder 20 Schritte, dann übernimmt Claude.', 'Lokale Modelle probieren gern dasselbe immer wieder. Ohne Bremse im Code läuft das ewig.'],
  ['Freigaben im Code, nicht im Prompt', 'Löschen, Installieren, Absenden nur nach deinem Okay. Das regelt der Code, das Modell kann es gar nicht umgehen.', 'origami hat neun Schutzschichten zwischen Gemma und dem PC. Die meisten sind entstanden, weil ein Test eine Lücke gefunden hat.', '„Bitte niemals löschen“ im Prompt ist eine Bitte, keine Sperre.'],
  ['Gedächtnis mit Bedacht', 'Dauerhafte Fakten gezielt speichern lassen, mit Rückgängig-Knopf. Lange Chats automatisch zusammenfassen, Wichtiges wörtlich behalten.', 'Ein neuer Gedächtnis-Eintrag kostet die nächste Anfrage ca. 20 s extra. Chat-Fenster bei mir ca. 16.000 Tokens.', 'Jeder neue Eintrag ändert den Prompt, dann wird alles neu eingelesen (siehe Schritt 3). Keine Passwörter oder Gesundheitsdaten speichern.'],
  ['Sicher von unterwegs, und stabil', 'Zugriff über einen Tunnel wie Tailscale, Login mit Passwort plus Zwei-Faktor-Code. Dazu Autostart ohne Anmeldung, Neustart nach Absturz und ein nächtliches Backup.', 'Bei mir: steht nach Absturz nach 5 s wieder auf, Backup um 3 Uhr, 14 Tage werden aufgehoben.', 'Verwaltungsseiten nur direkt am PC, nie übers Internet. Und Windows-Grenzen im Blick behalten: Ein Ausfall bei mir hing an zu wenigen freien Netzwerk-Ports und einer zu kleinen Auslagerungsdatei.'],
];
// Ori kommentiert am Rand (nur im Druck), zwei pro Seite
const ORI: Record<number, [string, string]> = {
  2: ['sassy', 'Eine Uhrzeit. Eine einzige. Und ich fang von vorn an.'],
  4: ['rechnet', 'Rechnen? Ich? Dafür gibt’s Code.'],
  7: ['seufzt', 'Bitten überhör ich. Sperren nicht.'],
  8: ['wissen', 'Ich merk mir alles. Fast alles.'],
};
const SEITEN = [SCHRITTE.slice(0, 5), SCHRITTE.slice(5)];
---
<Base titel="Der Faltplan: 10 Schritte zur eigenen KI" beschreibung="10 Schritte zur eigenen KI, jeder mit echter Messung und der Falle, in die ich getappt bin. Zum Ausdrucken.">
  <div class="wrap seite">
    <div class="nicht-drucken">
      <span class="kicker hand">Kostenlos, zum Ausdrucken</span>
      <h1>Der Faltplan</h1>
      <p class="seite-lead">10 Schritte zur eigenen KI. Wie man Ollama installiert, findest du überall. Hier steht, was sonst keiner aufschreibt: bei jedem Schritt meine echte Zahl und die Falle, in die ich getappt bin.</p>
      <div class="knoepfe" style="margin-bottom:32px"><button class="knopf voll" type="button" onclick="window.print()">Drucken oder als PDF speichern</button><a class="knopf" href="/werkzeuge">Zu den Werkzeugen</a></div>
    </div>
    <div class="faltplan-druck fp">
      {SEITEN.map((seite, si) => (
        <section class="fp-blatt pp-blatt">
          <PapierDeko />
          {si === 0 && (
            <>
            <div class="fp-kopf">
              <div>
                <PapierLogo />
                <b class="pp-titel"><span class="nur-druck pp-tape" aria-hidden="true"></span>Der Faltplan</b><br /><span>10 Schritte, 10 Fallen · gemessen mit origami · selbstgfaltet.de</span>
              </div>
              <img class="fp-kopf-ori" src="/anim/ruhezustand-abendrot.svg" alt="" width="72" height="72" />
            </div>
            </>
          )}
          {si > 0 && (
            <div class="nur-druck pp-kopf2">
              <PapierLogo />
              <span>Der Faltplan, Schritte 6 bis 10</span>
            </div>
          )}
          <ol style={`counter-reset:f ${si * 5}`}>
            {seite.map(([t, tun, zahl, falle], i) => {
              const ori = ORI[si * 5 + i];
              return (
                <li class={ori ? 'hat-ori' : undefined}>
                  <span class="box"></span>
                  <div>
                    <b>{t}</b>
                    <p class="fp-tun">{tun}</p>
                    <p class="fp-zahl"><span>Gemessen</span>{zahl}</p>
                    <p class="fp-falle"><span>Falle</span>{falle}</p>
                  </div>
                  {ori && (
                    <span class="nur-druck pp-ori fp-ori"><img src={`/anim/${ori[0]}-abendrot.svg`} alt="" width="46" height="46" /><em>{ori[1]}</em></span>
                  )}
                </li>
              );
            })}
          </ol>
          {si === SEITEN.length - 1 && (
            <>
              <p class="fp-fuss">Alles abgehakt? Dann hast du dir deine eigene KI gefaltet. – Ori</p>
              <p class="fp-klein">Gemessen auf einer RTX 4060 (8 GB) mit 32 GB Arbeitsspeicher und gemma4:26b, November 2026. Auf anderer Hardware sind die Zahlen anders, die Fallen meistens nicht.</p>
            </>
          )}
          <PapierFuss seite={si + 1} von={SEITEN.length} />
        </section>
      ))}
    </div>
  </div>
</Base>
<style>
  /* Faltplan ist ein Blatt Papier: immer hell, auch im dunklen Modus */
  .fp{background:#fffdf8 !important; color:#1d2742 !important; border-color:#1d2742}
  .fp li > div > b,.fp-kopf b{color:#1d2742}
  .fp .box{border-color:#1d2742; background:#fff}
  .fp-kopf{display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:18px}
  .fp-kopf b{font-family:var(--display); font-size:1.6rem}
  .fp-kopf span{color:#5d6478; font-size:.9rem}
  .fp li{grid-template-columns:34px 26px 1fr}
  .fp li > div > b{font-size:1.05rem}
  .fp p{margin:4px 0 0; font-size:.93rem; line-height:1.45}
  .fp-tun{color:#3b4258}
  .fp-zahl span,.fp-falle span{display:inline-block; font-family:var(--display); font-weight:700; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; padding:1px 7px; border-radius:5px; margin-right:7px}
  .fp-zahl span{background:#dff3e7; color:#23784a}
  .fp-falle span{background:#fde4d6; color:#c2410c}
  .fp .fp-fuss{margin:20px 0 0; font-family:var(--hand); font-size:1.4rem; color:#c2410c}
  .fp .fp-klein{font-size:.8rem; color:#5d6478}
  .fp ol{list-style:none}
  .fp-blatt + .fp-blatt ol{margin-top:14px}
  @media print{
    /* ein Blatt beidseitig: Schritte 1-5 vorne, 6-10 hinten, gut lesbare Schrift */
    .fp{max-width:none !important; width:100%; margin:0; padding:0 !important; box-shadow:none !important; border:0 !important; border-radius:0; background:#fff !important;
      -webkit-print-color-adjust:exact; print-color-adjust:exact}
    .fp-kopf{margin-bottom:8px}
    .fp-kopf b{font-size:1.6rem}
    .fp-kopf span{font-size:12px}
    .fp-kopf img{width:56px; height:56px}
    .fp ol{gap:13px}
    .fp li{grid-template-columns:30px 22px 1fr; gap:10px; break-inside:avoid; page-break-inside:avoid}
    .fp-kopf{position:relative; z-index:1}
    .fp-kopf-ori{display:none}
    .fp-kopf :global(.pp-logo){margin-bottom:10px}
    .fp li{position:relative}
    .fp li.hat-ori > div{padding-right:150px}
    .fp-ori{position:absolute !important; right:0; top:2px; width:140px}
    .fp li::before{font-size:1.4rem}
    .fp .box{width:18px; height:18px; margin-top:2px}
    .fp li > div > b{font-size:17px}
    .fp p{font-size:13.5px; line-height:1.4; margin-top:3px}
    .fp-zahl span,.fp-falle span{font-size:10px; padding:1px 5px; margin-right:6px}
    .fp .fp-fuss{font-size:1.5rem; margin-top:12px; break-inside:avoid}
    .fp .fp-klein{font-size:12px; margin-top:4px}
  }
</style>
<style is:global>
  /* Druck: A4 hochkant, zwei Seiten (beidseitig = ein Blatt) */
  @media print{
    html,body{background:#fff !important}
    .wrap.seite{max-width:none; padding:0; margin:0}
  }
</style>
