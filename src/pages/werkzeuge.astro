---
import Base from '../layouts/Base.astro';
import Ori from '../components/Ori.astro';
import Baustein from '../components/Baustein.astro';
import { GLOSSAR } from '../glossar';
---
<Base titel="Werkzeuge" aktiv="werkzeuge" beschreibung="Token-Uhr, Lokal-oder-Claude-Test, Modell-Rechner mit echten Messwerten, Prompt-Baukasten, Spickzettel, Fehler-Diagnose und Glossar für deine eigene KI.">
  <div class="wrap seite">
    <span class="kicker hand">Zum Ausprobieren</span>
    <h1>Werkzeuge</h1>
    <p class="seite-lead">Kleine Helfer, die dir Fragen beantworten, bevor du Geld ausgibst oder Stunden verlierst. Alles läuft in deinem Browser, nichts wird verschickt.</p>

    <div class="dl-hinweis"><b>Neu: Die Werkzeugkiste zum Download.</b> PC-Check, Modell-Prüfstand und der origami-Bauplan für Claude Code. <a href="/downloads">Zu den Downloads</a></div>

    <Baustein titel="Token-Uhr: Wie lange liest meine KI das?" icon="messung" id="token">
      <div class="feld"><label for="tktext">Text oder Prompt reinkopieren</label><textarea id="tktext" rows="6" placeholder="Zum Beispiel deine Anweisungen an die KI, eine Mail oder ein Stück Code"></textarea></div>
      <div class="tk-werte" aria-live="polite">
        <div><b id="tkzeichen">0</b><span>Zeichen</span></div>
        <div><b id="tktoken">0</b><span>Tokens (geschätzt)</span></div>
        <div><b id="tklesen">0 s</b><span>Einlesen bei mir</span></div>
        <div><b id="tkschreiben">0 s</b><span>gleich lang schreiben</span></div>
      </div>
      <div class="gpu-ori"><Ori name="liest" alt="Ori liest" /><span class="hand" id="tkori">Gib mir was zu lesen.</span></div>
      <p class="klein">Tokens grob geschätzt mit etwa 4 Zeichen pro Token, die echte Zahl hängt vom Modell ab. Zeiten gemessen mit gemma4:26b auf einer RTX 4060 (8 GB): ca. 130 Tokens pro Sekunde beim Einlesen, 27–30 beim Schreiben. Bei origami geht alles über 700 Zeichen direkt an Claude.</p>
    </Baustein>

    <Baustein titel="Lokal oder Claude? Wer würde antworten" icon="diagnose" id="route">
      <p style="margin-top:0">Tipp eine Nachricht wie im Chat. Du siehst, ob origami sie selbst mit Gemma beantwortet oder direkt an Claude gibt. Das sind die echten Wortlisten aus origami, Stand 9.11.2026.</p>
      <div class="feld"><label for="rtext">Deine Nachricht</label><textarea id="rtext" rows="3" placeholder="z. B. erinner mich morgen an den Müll, oder: schreib mir ein PowerShell-Skript"></textarea></div>
      <div class="rt-beispiele">
        {['wie wird das wetter morgen', 'merk dir, meine Katze heißt Findus', 'schreib mir ein skript, das alle pcs anpingt', 'vergleich mir drei grafikkarten mit preisen', 'warum ist mein wlan so langsam', 'fass diese seite zusammen'].map((b) => <button type="button" class="chip-knopf" data-beispiel={b}>{b}</button>)}
      </div>
      <div class="rt-urteil" id="rurteil" aria-live="polite"></div>
      <p class="klein">Die Entscheidung trifft keine KI, sondern eine feste Wortliste. Kurze Alltagssachen bleiben bei Gemma, Code, Recherche, IT-Fachfragen und alles über 700 Zeichen gehen direkt an Claude. Bleibt etwas bei Gemma und sie kommt nicht weiter, holt sie sich Claude trotzdem dazu. Mehr im Artikel <a href="/blog/lokal-oder-claude">Lokal oder Claude?</a></p>
    </Baustein>

    <Baustein titel="Passt das auf meinen PC?" icon="gpu" id="gpu" class="rechner">
      <div class="rein2">
        <fieldset class="chips" id="vramwahl"><legend>Speicher der Grafikkarte (VRAM)</legend>
          {[6, 8, 10, 12, 16, 24, 32].map((g) => <label class="chip-wahl"><input type="radio" name="vram" value={g} checked={g === 8} /><span>{g} GB</span></label>)}
        </fieldset>
        <fieldset class="chips" id="ramwahl"><legend>Arbeitsspeicher (RAM)</legend>
          {[16, 32, 64].map((g) => <label class="chip-wahl"><input type="radio" name="ram" value={g} checked={g === 32} /><span>{g} GB</span></label>)}
        </fieldset>
      </div>
      <div class="gpu-ori"><Ori name="rechnet" alt="Ori rechnet" /><span class="hand" id="orisagt">Mit 8 GB kommst du weit. Nur nicht ganz bis oben.</span></div>
      <div class="gpu-tafel">
        <div class="gpu-linie" id="gpulinie"><span id="gpulinietext">deine 8 GB</span></div>
        <div id="gpuraus" aria-live="polite"></div>
      </div>
      <p class="klein">Geschätzt mit einer Faustregel für Modelle in 4-Bit-Größe (Q4), wie Ollama sie standardmäßig lädt: etwa 0,6 GB pro Milliarde Parameter plus 1,5 GB für das Gespräch. Modelle mit Experten-Aufbau (MoE) laufen oft schneller, als die Größe vermuten lässt.</p>
      <h3 style="margin:22px 0 8px">Echt gemessen bei mir</h3>
      <p class="klein" style="margin-top:0">RTX 4060 (8 GB), 32 GB RAM, dieselben 10 Aufgaben, ohne Hilfe aus der Cloud. Mehr dazu im <a href="/blog/modell-dreikampf">Modell-Dreikampf</a>.</p>
      <div class="tabwrap"><table class="gemessen">
        <thead><tr><th>Modell</th><th>Größe</th><th>Punkte</th><th>Ø pro Aufgabe</th><th>ohne Antwort</th></tr></thead>
        <tbody>
          <tr><td><b>Gemma 4 26B</b></td><td>15 GB</td><td>81 / 100</td><td>54 s</td><td>0 von 10</td></tr>
          <tr><td><b>Qwen3.6 35B</b></td><td>23 GB</td><td>76 / 100</td><td>2:51 Min.</td><td>1 von 10</td></tr>
          <tr><td><b>Qwen3.5 9B</b></td><td>6 GB</td><td>30 / 100</td><td>56 s</td><td>6 von 10</td></tr>
        </tbody>
      </table></div>
    </Baustein>

    <Baustein titel="Prompt-Baukasten: Sag der KI, was du willst" icon="falt" id="prompt">
      <p style="margin-top:0">Füll aus, was du weißt. Leere Felder fliegen raus. Funktioniert für Claude, ChatGPT und lokale Modelle.</p>
      <div class="pb-felder">
        <div class="feld"><label for="pbrolle">Wer soll die KI sein?</label><input id="pbrolle" placeholder="z. B. erfahrene Windows-Admin, geduldige Lehrerin" /></div>
        <div class="feld"><label for="pbaufgabe">Was soll sie tun? <small>(das Wichtigste)</small></label><textarea id="pbaufgabe" rows="3" placeholder="z. B. Schreib ein PowerShell-Skript, das alle Dateien älter als 30 Tage in einen Ordner verschiebt"></textarea></div>
        <div class="feld"><label for="pbkontext">Was muss sie wissen?</label><textarea id="pbkontext" rows="3" placeholder="z. B. Windows 11, ich bin Anfänger, das Skript soll per Doppelklick laufen"></textarea></div>
        <div class="feld"><label for="pbformat">Wie soll die Antwort aussehen?</label><input id="pbformat" placeholder="z. B. erst der Code, dann drei Sätze Erklärung" /></div>
        <div class="feld"><label for="pbnicht">Was soll sie nicht tun?</label><input id="pbnicht" placeholder="z. B. nichts löschen, keine Fachbegriffe ohne Erklärung" /></div>
        <div class="feld"><label for="pbbeispiel">Beispiel, wie's aussehen soll</label><textarea id="pbbeispiel" rows="2" placeholder="optional, hilft enorm"></textarea></div>
        <label class="pb-haken"><input type="checkbox" id="pbfragen" checked /> Sie soll nachfragen, wenn was unklar ist</label>
      </div>
      <div class="feld" style="margin-top:14px"><label for="pbraus">Dein Prompt</label><textarea id="pbraus" rows="9" readonly></textarea></div>
      <div class="knoepfe" style="margin-top:10px"><button class="knopf voll" id="pbkopie" type="button">Kopieren</button><span class="hand" id="pbori" style="align-self:center"></span></div>
    </Baustein>

    <Baustein titel="Spickzettel zum Ausdrucken" icon="buch" id="spick">
      <p style="margin-top:0">Die wichtigsten Befehle für Ollama und Claude Code und die Regeln für gute Prompts. Eine Seite, passt neben die Tastatur.</p>
      <div class="knoepfe"><a class="knopf voll" href="/spickzettel">Spickzettel öffnen</a></div>
    </Baustein>

    <Baustein titel="Fehler-Diagnose: Warum macht meine KI das?" icon="diagnose" id="diagnose">
      <div class="diag" id="diag">
        <div class="ori-mini"><Ori name="ratlos" alt="Ori ist ratlos" /><span class="hand">Erzähl. Ich hör zu. Meistens.</span></div>
        <div class="pfad" id="diagpfad"></div>
        <div class="frage" id="diagfrage"></div>
        <div class="antworten" id="diagantw"></div>
        <div id="diagerg"></div>
      </div>
      <noscript><p>Die Diagnose braucht JavaScript.</p></noscript>
    </Baustein>

    <Baustein titel="Fachchinesisch auf Deutsch" icon="buch" id="glossar">
      <div class="glkopf">
        <div class="feld" style="flex:1"><label for="glsuche">Begriff suchen</label><input id="glsuche" type="search" placeholder="z. B. Token" /></div>
        <div class="ori-mini"><Ori name="wissen" alt="Ori weiß was" /></div>
      </div>
      <div class="wasmacht" id="glliste">
        {GLOSSAR.map(([w, t, b]) => <div class="teil gl"><div class="wer">{w}</div><p>{t}</p><div class="bild">= {b}</div></div>)}
      </div>
    </Baustein>
  </div>
</Base>

<script>
  const oriNochmal = (img: HTMLImageElement) => (window as any).oriNochmal?.(img);
  // Token-Uhr
  const tk = document.getElementById('tktext') as HTMLTextAreaElement;
  const zeit = (s: number) => s < 60 ? `${Math.round(s)} s` : `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')} Min.`;
  function tkRechne() {
    const z = tk.value.length, t = Math.ceil(z / 4);
    document.getElementById('tkzeichen')!.textContent = z.toLocaleString('de-DE');
    document.getElementById('tktoken')!.textContent = t.toLocaleString('de-DE');
    document.getElementById('tklesen')!.textContent = zeit(t / 130);
    document.getElementById('tkschreiben')!.textContent = t ? `${zeit(t / 30)}–${zeit(t / 27)}` : '0 s';
    const o = document.getElementById('tkori')!;
    o.textContent = !z ? 'Gib mir was zu lesen.' : z > 700 ? 'Über 700 Zeichen. Bei origami ginge das direkt an Claude.' : t / 130 < 2 ? 'Zack, gelesen.' : 'Moment. Ich les noch.';
  }
  tk.addEventListener('input', tkRechne);

  // Prompt-Baukasten
  const pb = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value.trim();
  const pbRaus = document.getElementById('pbraus') as HTMLTextAreaElement;
  function pbBau() {
    const teile: string[] = [];
    if (pb('pbrolle')) teile.push(`Du bist ${pb('pbrolle')}.`);
    if (pb('pbaufgabe')) teile.push(`## Aufgabe\n${pb('pbaufgabe')}`);
    if (pb('pbkontext')) teile.push(`## Was du wissen musst\n${pb('pbkontext')}`);
    if (pb('pbformat')) teile.push(`## So soll die Antwort aussehen\n${pb('pbformat')}`);
    if (pb('pbnicht')) teile.push(`## Bitte nicht\n${pb('pbnicht')}`);
    if (pb('pbbeispiel')) teile.push(`## Beispiel\n${pb('pbbeispiel')}`);
    if ((document.getElementById('pbfragen') as HTMLInputElement).checked && teile.length) teile.push('Wenn etwas unklar ist, frag zuerst nach, statt zu raten.');
    pbRaus.value = teile.join('\n\n');
    document.getElementById('pbori')!.textContent = !pb('pbaufgabe') ? 'Ohne Aufgabe kann ich nur raten.' : teile.length >= 5 ? 'So versteh sogar ich das.' : '';
  }
  document.querySelectorAll('#prompt input, #prompt textarea:not([readonly])').forEach((el) => el.addEventListener('input', pbBau));
  document.getElementById('pbfragen')!.addEventListener('change', pbBau);
  document.getElementById('pbkopie')!.addEventListener('click', async () => {
    const k = document.getElementById('pbkopie')!;
    try { await navigator.clipboard.writeText(pbRaus.value); k.textContent = 'Kopiert'; } catch { pbRaus.select(); k.textContent = 'Markiert, Strg+C drücken'; }
    setTimeout(() => (k.textContent = 'Kopieren'), 2000);
  });
  pbBau();

  // Lokal oder Claude (echte Wortlisten aus origami lib/route.js, Stand 9.11.2026)
  const LOKAL = /\b(erinner\w*|reminder|merk(e)?\s+dir|vergiss|vergessen|wie\s+spät|uhrzeit|welcher\s+tag|platz\s+(auf|hab)|speicherplatz|zeig\s+mir|öffne|mach\s+auf|liste?\s+(meine|den|die)|wie\s+heißt|danke|hallo|hi|moin|servus|guten\s+(morgen|abend|tag)|wetter)\b/i;
  const WEGE: [string, RegExp][] = [
    ['Recherche', /\b(recherchier\w*|vergleich\w*|preisvergleich|kaufberatung|marktübersicht|was\s+(ist|wäre)\s+besser|lohnt\s+sich|beste[nrs]?\s+\w+\s+(unter|bis|für)|(such|find)\w*\s+(mir\s+)?(mal\s+)?\d+|mit\s+(quelle|quellen|link|links)|aktuelle[nrs]?\s+(preise?|angebote|modelle))\b/i],
    ['Code', /\b(skript\w*|script\w*|programmier\w*|code|coden|powershell|python|javascript|typescript|node\.?js|(?<!\.)html|(?<!\.)css|sql|regex|(?<!\.)json|api|bug|debug\w*|fehler\s+im\s+code|funktion\s+(schreib|bau)\w*|bau\s+mir|baue?\s+(mir\s+)?(ein|eine|einen)|programm|tool|app|spiel\s+(bau|programmier|erstell|entwickel)\w*|seite\s+(bau|erstell|mach)\w*|tetris|website|webseite\s+(bau|erstell))\b/i],
    ['IT-Fachfrage', /\b(gpo|gruppenrichtlinie\w*|active\s+directory|härtung|hardening|firewall|vlan|dhcp|dns|intune|exchange|m365|microsoft\s+365|entra|azure|phishing|sicherheitslücke|cve|ransomware|backup-?konzept|raid|bitlocker|laps|domäne|domain|netzwerk\w*|wlan|router|switch|vpn|fehlersuche|troubleshoot\w*|checkliste|konzept|richtlinie)\b/i],
  ];
  const rText = document.getElementById('rtext') as HTMLTextAreaElement;
  const rUrteil = document.getElementById('rurteil')!;
  const hx = (t: string) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
  function urteil() {
    const t = rText.value.trim();
    const zeig = (wer: string, warum: string) => { rUrteil.innerHTML = `<span class="rt-wer ${wer === 'Gemma' ? 'g' : 'c'}">${wer}</span><span>${warum}</span>`; };
    if (!t) { rUrteil.innerHTML = '<span class="klein">Schreib oben was rein oder tipp ein Beispiel an.</span>'; return; }
    const l = t.match(LOKAL);
    if (l && t.length < 160) return zeig('Gemma', `Alltags-Stichwort <mark>${hx(l[0])}</mark> und kurz. Bleibt auf dem PC.`);
    for (const [name, re] of WEGE) { const m = t.match(re); if (m) return zeig('Claude', `${name} erkannt an <mark>${hx(m[0])}</mark>. Geht direkt in die Cloud.`); }
    if (t.length > 700) return zeig('Claude', 'Über 700 Zeichen. Lange Texte liest Claude schneller ein.');
    zeig('Gemma', 'Kein Stichwort gefunden, bleibt auf dem PC. Kommt Gemma nicht weiter, holt sie sich Claude dazu.');
  }
  rText.addEventListener('input', urteil);
  document.querySelectorAll<HTMLButtonElement>('[data-beispiel]').forEach((b) => b.addEventListener('click', () => { rText.value = b.dataset.beispiel!; urteil(); }));
  urteil();

  // GPU-Rechner
  const modelle: [string, number][] = [['4B', 4], ['8B', 8], ['14B', 14], ['27B', 27], ['32B', 32], ['70B', 70]];
  const wert = (n: string) => +(document.querySelector<HTMLInputElement>(`input[name=${n}]:checked`)!.value);
  const raus = document.getElementById('gpuraus')!;
  const sagt = document.getElementById('orisagt')!;
  const SKALA = 46;
  function rechne() {
    const v = wert('vram'), r = wert('ram');
    const linie = document.getElementById('gpulinie')!;
    linie.style.left = `calc(var(--namebreite) + 12px + (100% - var(--namebreite) - var(--etikett) - 24px) * ${v / SKALA})`;
    document.getElementById('gpulinietext')!.textContent = `deine ${v} GB`;
    raus.innerHTML = modelle.map(([n, p]) => {
      const gb = Math.round((p * 0.6 + 1.5) * 10) / 10;
      const gpu = Math.min(gb, v), cpu = Math.max(0, gb - v);
      let etikett: string, kl: string;
      if (gb <= v) { etikett = '✓ passt'; kl = 'ok'; }
      else if (cpu <= r * 0.6) { etikett = `${Math.round((cpu / gb) * 100)} % CPU`; kl = 'halb'; }
      else { etikett = '✕ zu groß'; kl = 'nein'; }
      const gbTxt = String(gb).replace('.', ',');
      return `<div class="gzeile ${kl}"><div class="gname"><b>${n}</b><small>${gbTxt}&nbsp;GB</small></div><div class="gspur"><i class="gteil gpu" style="width:${(gpu / SKALA) * 100}%"></i><i class="gteil cpu" style="left:${(gpu / SKALA) * 100}%;width:${(cpu / SKALA) * 100}%"></i></div><span class="getikett">${etikett}</span></div>`;
    }).join('');
    sagt.textContent = v >= 24 ? 'Jetzt wird\'s ernst. Ich bin neidisch.' : v >= 16 ? 'Solide. Die mittleren Modelle fliegen.' : v >= 8 ? `Mit ${v} GB kommst du weit. Nur nicht ganz bis oben.` : 'Klein, aber ehrlich. Fang mit 4B an.';
    document.querySelectorAll<HTMLImageElement>('#gpu img.ori').forEach(oriNochmal);
  }
  document.querySelectorAll('input[name=vram], input[name=ram]').forEach((i) => i.addEventListener('change', rechne));
  rechne();

  // Glossar-Suche
  const gs = document.getElementById('glsuche') as HTMLInputElement;
  gs.addEventListener('input', () => {
    const q = gs.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('#glliste .gl').forEach((g) => { g.hidden = !!q && !g.textContent!.toLowerCase().includes(q); });
  });

  // Fehler-Diagnose (Entscheidungsbaum)
  type Knoten = { f: string; a: [string, string][] } | { e: string; t: string; l?: string; link?: string };
  const B: Record<string, Knoten> = {
    start: { f: 'Was nervt dich gerade am meisten?', a: [['Sie ist langsam', 'lang'], ['Sie macht nicht, was ich sage', 'regel'], ['Sie hängt oder antwortet nie', 'haengt'], ['Die Antworten sehen komisch aus', 'komisch']] },
    lang: { f: 'Ist nur die erste Antwort langsam, und danach geht\'s schneller?', a: [['Ja, genau', 'cache'], ['Nein, alles ist langsam', 'vram']] },
    cache: { e: 'Der Zwischenspeicher greift nicht', t: 'Das Modell liest den Anfang jedes Mal neu ein. Meist steht vorne im Prompt etwas, das sich ändert, zum Beispiel die Uhrzeit oder eine wechselnde Werkzeugliste.', l: 'Anfang des Prompts konstant halten, Wechselndes an die Nachricht hängen, vorwärmen.' },
    vram: { e: 'Das Modell passt nicht in die Grafikkarte', t: 'Liegt ein Teil des Modells im normalen Arbeitsspeicher, rechnet die CPU mit, und das ist viel langsamer.', l: 'Kleineres Modell nehmen oder im GPU-Rechner prüfen, was passt.', link: '#gpu' },
    regel: { f: 'Steht die Regel nur in den Anweisungen (System-Prompt)?', a: [['Ja', 'prompt'], ['Nein, sie ist auch im Code', 'werkzeug']] },
    prompt: { e: 'Regeln im System-Prompt wirken schwach', t: 'Lange Anweisungen ganz oben verlieren an Gewicht, bis das Modell bei deiner Frage ankommt.', l: 'Harte Regeln in den Code, Hinweise direkt ins Werkzeug-Ergebnis.' },
    werkzeug: { e: 'Das Werkzeug-Ergebnis sagt nicht deutlich genug, was zu tun ist', t: 'Das Modell entscheidet nach dem, was es zuletzt gelesen hat. Ist das Ergebnis eines Werkzeugs vage, rät es.', l: 'Klare Hinweise ins Ergebnis schreiben, zum Beispiel „Frag den Nutzer, bevor du weitermachst“.' },
    haengt: { f: 'Kommt vorher eine Flut aus Leerzeilen oder endloses „Nachdenken“?', a: [['Leerzeilen', 'leer'], ['Endloses Nachdenken', 'denken'], ['Weiß ich nicht', 'waechter']] },
    leer: { e: 'Leerzeilen-Flut legt die Textprüfung lahm', t: 'Suchmuster in deiner Nachbearbeitung können an sehr langem Leerraum hängen bleiben und den ganzen Server blockieren.', l: 'Nach 400 Zeichen Leerraum abbrechen, Textprüfungen mit Zeitlimit laufen lassen.' },
    denken: { e: 'Denk-Schleife', t: 'Manche Modelle denken im Kreis und kommen nie zur Antwort.', l: 'Nach einer festen Länge abbrechen und einmal ohne Nachdenken neu fragen. Klappt das nicht, an ein stärkeres Modell übergeben.' },
    waechter: { e: 'Erst mal absichern', t: 'Ohne Protokoll weißt du nicht, was passiert ist.', l: 'Jede Anfrage protokollieren und einen Wächter einbauen, der neu startet, wenn minutenlang nichts kommt.' },
    komisch: { f: 'Was genau ist komisch?', a: [['Sie wiederholt sich oder unterschreibt', 'wdh'], ['Werkzeug-Aufrufe stehen als Text da', 'tooltext']] },
    wdh: { e: 'Typische Modell-Macken', t: 'Lokale Modelle hängen gern ihren Namen an oder schreiben denselben Absatz zweimal.', l: 'Eine Nachbearbeitung, die doppelte Absätze und Unterschriften entfernt. Jede Regel mit Testfall.' },
    tooltext: { e: 'Das Modell schreibt den Werkzeug-Aufruf, statt ihn auszuführen', t: 'Kleinere Modelle formatieren den Aufruf manchmal als normalen Text.', l: 'Solche Texte erkennen und den Aufruf trotzdem ausführen. Schon erledigte Aufrufe überspringen.' },
  };
  const pfad: string[] = [];
  const elF = document.getElementById('diagfrage')!, elA = document.getElementById('diagantw')!, elE = document.getElementById('diagerg')!, elP = document.getElementById('diagpfad')!;
  function zeige(id: string) {
    const k = B[id];
    elA.innerHTML = ''; elE.innerHTML = '';
    elP.textContent = pfad.length ? 'Deine Antworten: ' + pfad.join(' → ') : '';
    if ('f' in k) {
      elF.textContent = k.f;
      k.a.forEach(([txt, ziel]) => {
        const b = document.createElement('button'); b.className = 'knopf'; b.type = 'button'; b.textContent = txt;
        b.onclick = () => { pfad.push(txt); zeige(ziel); };
        elA.appendChild(b);
      });
    } else {
      elF.textContent = 'Das ist es vermutlich:';
      elE.innerHTML = `<div class="ergebnis"><h3>${k.e}</h3><p>${k.t}</p>${k.l ? `<p><b>Lösung:</b> ${k.l}</p>` : ''}${k.link ? `<p><a href="${k.link}">Mehr dazu →</a></p>` : ''}</div>`;
      const b = document.createElement('button'); b.className = 'knopf'; b.type = 'button'; b.textContent = 'Nochmal von vorn';
      b.onclick = () => { pfad.length = 0; zeige('start'); };
      elA.appendChild(b);
      document.querySelectorAll<HTMLImageElement>('#diagnose img.ori').forEach(oriNochmal);
    }
  }
  zeige('start');
</script>
