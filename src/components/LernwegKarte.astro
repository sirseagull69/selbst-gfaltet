---
interface Props { weg: any }
const { weg } = Astro.props;
const da = weg.teile.filter((t: any) => t.slug).length;
---
<a class="weg" href={`/anleitungen#weg-${weg.nr}`}>
  <span class="nr">ANLEITUNG {weg.nr} · {weg.teile.length} TEILE</span>
  <h3>{weg.titel}</h3>
  <p>{weg.kurz}</p>
  <div class="meta">{weg.chips.map((c: string) => <span class="chip">{c}</span>)}</div>
  <div class="fortschritt" aria-label={`${da} von ${weg.teile.length} Teilen erschienen`}>{weg.teile.map((t: any) => <span class={t.slug ? 'da' : ''}></span>)}</div>
</a>
