---
// „Frag mich“-Kasten unter Artikeln. Kein Formular-Dienst, kein Speichern:
// der Knopf öffnet nur das Mailprogramm mit fertigem Betreff an fragen@selbstgfaltet.de.
import Ori from './Ori.astro';
interface Props { thema?: string; ori?: string }
const { thema = '', ori = 'denkt-nach-3' } = Astro.props;
const betreff = thema ? `Frage zu: ${thema}` : 'Frage an Selbst gfaltet';
---
<section class="frage" data-betreff={betreff}>
  <div class="fr-ori"><Ori name={ori} alt="" /></div>
  <div class="fr-inhalt">
    <h2>Hängst du irgendwo?</h2>
    <p>Schreib mir deine Frage. Ich antworte, und die besten Fragen werden vielleicht ein eigener Artikel. Dein Name kommt dabei nie vor, versprochen.</p>
    <label class="fr-versteckt" for="fr-text">Deine Frage</label>
    <textarea id="fr-text" rows="3" placeholder="z. B. Mein Modell antwortet nur Kauderwelsch, was mach ich falsch?"></textarea>
    <div class="fr-zeile">
      <button type="button" class="knopf voll" id="fr-los">Frage per Mail schicken</button>
      <span class="fr-hand">Ich bin gespannt. Ehrlich.</span>
    </div>
    <p class="fr-klein">Öffnet dein Mailprogramm mit der Frage drin. Hier auf der Seite wird nichts gespeichert oder verschickt. Lieber direkt? <a href="mailto:fragen@selbstgfaltet.de">fragen@selbstgfaltet.de</a></p>
  </div>
</section>
<script>
  document.getElementById('fr-los')?.addEventListener('click', () => {
    const box = document.querySelector<HTMLElement>('.frage')!;
    const text = (document.getElementById('fr-text') as HTMLTextAreaElement).value.trim();
    const url = `mailto:fragen@selbstgfaltet.de?subject=${encodeURIComponent(box.dataset.betreff || '')}&body=${encodeURIComponent(text ? text + '\n\n' : '')}`;
    location.href = url;
  });
</script>
<style>
  .frage{display:grid; grid-template-columns:110px minmax(0,1fr); gap:18px; align-items:start; margin:44px 0 0; padding:22px; background:var(--blatt); box-shadow:var(--schatten); border-radius:3px; border-left:5px solid var(--ori)}
  .fr-ori img{width:110px; height:110px}
  .frage h2{font-size:1.35rem; margin:0 0 4px}
  .frage p{margin:0 0 12px}
  .frage textarea{width:100%; box-sizing:border-box; font:inherit; font-size:1rem; padding:10px 12px; border:2px solid var(--tinte); border-radius:10px; background:var(--papier); color:var(--tinte); resize:vertical; min-height:84px}
  .fr-zeile{display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin:10px 0 8px}
  .fr-hand{font-family:var(--hand); color:var(--ori); font-size:1.25rem}
  .fr-klein{font-size:.85rem; color:var(--bleistift); margin:0!important}
  .fr-versteckt{position:absolute!important; left:-9999px; width:1px; height:1px; overflow:hidden}
  @media (max-width:560px){ .frage{grid-template-columns:minmax(0,1fr)} .fr-ori{display:none} }
</style>
