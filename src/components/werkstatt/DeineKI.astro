---
// Schaubild „Deine KI“ für die Werkstatt. Nachbau von Nils' Entwurf im Canvas
// „origami Animationen v2“ (Artboards KiLeer/KiHalb/KiFertig/KiPhone).
// Jedes Element hat data-k = Bauteil-ID; die Werkstatt setzt die Klassen .an / .fertig.
type El = { k: string; typ: 'box' | 'chip' | 'kern'; x: number; y: number; w: number; h: number; titel: string; unter?: string; icon?: string; modell?: boolean; pl?: number; eng?: boolean };
type Li = { k: string; x: number; y: number; l: number; v?: boolean };
type Lay = { name: string; W: number; H: number; rahmen: [number, number, number, number]; ori: [number, number]; els: El[]; li: Li[]; labels: [string, number, number, string][] };

const ICON: Record<string, string> = {
  handy: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>',
  schloss: '<rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  browser: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M7 13h6"/>',
  schild: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/>',
  stopp: '<path d="M8.5 3h7L21 8.5v7L15.5 21h-7L3 15.5v-7z"/><path d="M9 12h6"/>',
  wolke: '<path d="M7 18a4 4 0 0 1-.5-8 5.5 5.5 0 0 1 10.6-1.5A4.5 4.5 0 0 1 17 18z"/>',
  chip: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
  kreis: '<path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4h-4"/>',
};

const DESK: Lay = {
  name: 'desk', W: 1100, H: 440, rahmen: [520, 64, 320, 356], ori: [552, 112],
  li: [
    { k: 'tunnel', x: 104, y: 156, l: 24 }, { k: 'login', x: 200, y: 156, l: 24 }, { k: 'fundament', x: 356, y: 156, l: 184 },
    { k: 'fundament', x: 820, y: 156, l: 42 }, { k: 'fundament', x: 862, y: 156, l: 22 },
    { k: 'claude', x: 858, y: 54, l: 106, v: true }, { k: 'claude', x: 862, y: 50, l: 22 },
    { k: 'dauerlauf', x: 978, y: 206, l: 26, v: true }, { k: 'anfang', x: 434, y: 144, l: 16, v: true },
    { k: 'vorwaermen', x: 434, y: 160, l: 16, v: true }, { k: 'fundament', x: 552, y: 220, l: 32, v: true },
  ],
  els: [
    { k: 'tunnel', typ: 'box', x: 20, y: 124, w: 84, h: 72, titel: 'Handy', icon: 'handy' },
    { k: 'login', typ: 'box', x: 128, y: 136, w: 72, h: 48, titel: 'Login', icon: 'schloss', eng: true },
    { k: 'fundament', typ: 'box', x: 224, y: 124, w: 132, h: 72, titel: 'Chat', unter: 'im Browser', icon: 'browser' },
    { k: 'anfang', typ: 'chip', x: 376, y: 104, w: 124, h: 40, titel: 'Fester<br>Prompt-Anfang' },
    { k: 'vorwaermen', typ: 'chip', x: 386, y: 176, w: 104, h: 32, titel: 'Vorwärmen' },
    { k: 'fundament', typ: 'kern', x: 540, y: 100, w: 280, h: 120, titel: 'Grundgerüst', unter: 'Hier läuft alles zusammen.', pl: 122 },
    { k: 'rechnen', typ: 'chip', x: 540, y: 252, w: 80, h: 30, titel: 'Rechnen' },
    { k: 'wetter', typ: 'chip', x: 628, y: 252, w: 76, h: 30, titel: 'Wetter' },
    { k: 'befehle', typ: 'chip', x: 712, y: 252, w: 108, h: 30, titel: 'PC-Befehle' },
    { k: 'surfen', typ: 'chip', x: 540, y: 290, w: 136, h: 30, titel: 'Websuche' },
    { k: 'merken', typ: 'chip', x: 684, y: 290, w: 136, h: 30, titel: 'Gedächtnis' },
    { k: 'spezial', typ: 'chip', x: 540, y: 328, w: 100, h: 30, titel: 'Bahn & Co.' },
    { k: 'dateien', typ: 'chip', x: 648, y: 328, w: 76, h: 30, titel: 'Dateien' },
    { k: 'browser', typ: 'chip', x: 732, y: 328, w: 88, h: 30, titel: 'Browser' },
    { k: 'zusammenfassen', typ: 'chip', x: 540, y: 366, w: 100, h: 30, titel: 'Lange Chats' },
    { k: 'erinnern', typ: 'chip', x: 648, y: 366, w: 76, h: 30, titel: 'Erinnern' },
    { k: 'feedback', typ: 'chip', x: 732, y: 366, w: 88, h: 30, titel: 'Daumen ↑↓' },
    { k: 'freigaben', typ: 'chip', x: 536, y: 52, w: 116, h: 24, titel: 'Schutzschicht', icon: 'schild' },
    { k: 'notbremse', typ: 'chip', x: 716, y: 50, w: 108, h: 28, titel: 'Notbremse', icon: 'stopp' },
    { k: 'claude', typ: 'box', x: 884, y: 24, w: 196, h: 60, titel: 'Claude', unter: 'für die schweren Sachen', icon: 'wolke' },
    { k: 'fundament', typ: 'box', x: 884, y: 114, w: 196, h: 92, titel: 'Ollama + Modell', icon: 'chip', modell: true },
    { k: 'dauerlauf', typ: 'box', x: 884, y: 232, w: 196, h: 60, titel: 'Läuft von allein', unter: 'Neustart · Backup', icon: 'kreis' },
  ],
  labels: [['Tempo', 378, 76, 'hand'], ['Werkzeuge', 568, 224, 'hand']],
};
const PHONE: Lay = {
  name: 'phone', W: 360, H: 934, rahmen: [12, 252, 336, 436], ori: [40, 296],
  li: [
    { k: 'tunnel', x: 106, y: 108, l: 24 }, { k: 'login', x: 206, y: 108, l: 24 }, { k: 'fundament', x: 283, y: 140, l: 144, v: true },
    { k: 'anfang', x: 263, y: 169, l: 24 }, { k: 'vorwaermen', x: 263, y: 207, l: 24 }, { k: 'fundament', x: 40, y: 404, l: 32, v: true },
    { k: 'fundament', x: 304, y: 404, l: 310, v: true }, { k: 'fundament', x: 304, y: 714, l: 24, v: true },
    { k: 'claude', x: 84, y: 710, l: 224 }, { k: 'claude', x: 80, y: 714, l: 24, v: true }, { k: 'dauerlauf', x: 252, y: 830, l: 24, v: true },
  ],
  els: [
    { k: 'tunnel', typ: 'box', x: 16, y: 84, w: 90, h: 56, titel: 'Handy', icon: 'handy' },
    { k: 'login', typ: 'box', x: 130, y: 90, w: 76, h: 44, titel: 'Login', icon: 'schloss', eng: true },
    { k: 'fundament', typ: 'box', x: 230, y: 84, w: 114, h: 56, titel: 'Chat', unter: 'im Browser', icon: 'browser' },
    { k: 'anfang', typ: 'chip', x: 99, y: 158, w: 164, h: 30, titel: 'Fester Prompt-Anfang' },
    { k: 'vorwaermen', typ: 'chip', x: 159, y: 196, w: 104, h: 30, titel: 'Vorwärmen' },
    { k: 'fundament', typ: 'kern', x: 28, y: 284, w: 304, h: 120, titel: 'Grundgerüst', unter: 'Hier läuft alles zusammen.', pl: 122 },
    { k: 'rechnen', typ: 'chip', x: 28, y: 436, w: 124, h: 30, titel: 'Rechnen' },
    { k: 'wetter', typ: 'chip', x: 160, y: 436, w: 124, h: 30, titel: 'Wetter' },
    { k: 'befehle', typ: 'chip', x: 28, y: 474, w: 124, h: 30, titel: 'PC-Befehle' },
    { k: 'surfen', typ: 'chip', x: 160, y: 474, w: 124, h: 30, titel: 'Websuche' },
    { k: 'merken', typ: 'chip', x: 28, y: 512, w: 124, h: 30, titel: 'Gedächtnis' },
    { k: 'browser', typ: 'chip', x: 160, y: 512, w: 124, h: 30, titel: 'Browser' },
    { k: 'spezial', typ: 'chip', x: 28, y: 550, w: 124, h: 30, titel: 'Bahn & Co.' },
    { k: 'dateien', typ: 'chip', x: 160, y: 550, w: 124, h: 30, titel: 'Dateien' },
    { k: 'zusammenfassen', typ: 'chip', x: 28, y: 588, w: 124, h: 30, titel: 'Lange Chats' },
    { k: 'erinnern', typ: 'chip', x: 160, y: 588, w: 124, h: 30, titel: 'Erinnern' },
    { k: 'feedback', typ: 'chip', x: 28, y: 626, w: 124, h: 30, titel: 'Daumen ↑↓' },
    { k: 'freigaben', typ: 'chip', x: 28, y: 240, w: 116, h: 24, titel: 'Schutzschicht', icon: 'schild' },
    { k: 'notbremse', typ: 'chip', x: 160, y: 626, w: 108, h: 28, titel: 'Notbremse', icon: 'stopp' },
    { k: 'claude', typ: 'box', x: 16, y: 738, w: 136, h: 76, titel: 'Claude', unter: 'für die schweren Sachen' },
    { k: 'fundament', typ: 'box', x: 168, y: 738, w: 176, h: 92, titel: 'Ollama + Modell', modell: true },
    { k: 'dauerlauf', typ: 'box', x: 168, y: 854, w: 176, h: 60, titel: 'Läuft von allein', unter: 'Neustart · Backup' },
  ],
  labels: [['Tempo', 28, 161, 'hand'], ['Werkzeuge', 56, 408, 'hand']],
};
const ico = (n?: string, gr = 18) => n ? `<svg class="dki-ico" width="${gr}" height="${gr}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[n]}</svg>` : '';
---
<section class="dki" aria-label="Schaubild deiner KI">
  {[DESK, PHONE].map((L) => (
    <div class={`dki-${L.name}`} style={`aspect-ratio:${L.W}/${L.H}`} data-w={L.W}>
      <div class="dki-buehne" style={`width:${L.W}px;height:${L.H}px`}>
        <div class="dki-rahmen" data-k="freigaben" style={`left:${L.rahmen[0]}px;top:${L.rahmen[1]}px;width:${L.rahmen[2]}px;height:${L.rahmen[3]}px`}></div>
        {L.li.map((l) => (
          <svg class="dki-linie" data-k={l.k} aria-hidden="true" width={l.v ? 8 : l.l} height={l.v ? l.l : 8} viewBox={l.v ? `0 0 8 ${l.l}` : `0 0 ${l.l} 8`} preserveAspectRatio="none" style={`left:${l.x}px;top:${l.y}px`}><path d={l.v ? `M 4 0 L 4 ${l.l}` : `M 0 4 L ${l.l} 4`} /></svg>
        ))}
        {L.els.map((e) => (
          <>
            <div class={`dki-el dki-${e.typ}${e.eng ? ' dki-eng' : ''}`} data-k={e.k} style={`left:${e.x}px;top:${e.y}px;width:${e.w}px;height:${e.h}px${e.pl ? `;padding-left:${e.pl}px` : ''}`}>
              <span class="dki-ecke" aria-hidden="true"></span>
              <Fragment set:html={ico(e.icon, e.typ === 'chip' ? 13 : 18)} />
              {e.typ === 'chip'
                ? <span set:html={e.titel} />
                : <span><b set:html={e.titel} />{e.unter && <><br /><span class="dki-unter">{e.unter}</span></>}{e.modell && <><br /><span class="dki-modell">8 GB, Modell bis 8B</span></>}</span>}
            </div>
            <svg class="dki-haken" data-k={e.k} width={e.typ === 'chip' ? 14 : 16} height={e.typ === 'chip' ? 14 : 16} viewBox="0 0 16 16" aria-hidden="true" style={`left:${e.x - (e.typ === 'chip' ? 6 : 7)}px;top:${e.y - (e.typ === 'chip' ? 6 : 7)}px`}><circle cx="8" cy="8" r="8" /><path d="M4.5 8.3l2.3 2.3 4.7-5" /></svg>
          </>
        ))}
        <div class="dki-ori" style={`left:${L.ori[0]}px;top:${L.ori[1]}px`}>
          <img class="ori-light dki-ori-l" src="/anim/ruhezustand-3-abendrot.svg" alt="" width="96" height="96" />
          <img class="ori-dark dki-ori-d" src="/anim/ruhezustand-3-hell.svg" alt="" width="96" height="96" />
        </div>
        <div class="dki-titel" style={L.name === 'desk' ? 'left:20px;top:14px' : 'left:16px;top:14px;font-size:26px'}>Deine KI</div>
        <div class="dki-stand" style={L.name === 'desk' ? 'left:20px;top:50px' : 'left:16px;top:46px'}>1 von 14 eingebaut</div>
        {L.labels.map(([t, x, y]) => <div class="dki-label" style={`left:${x}px;top:${y}px`}>{t}</div>)}
        <div class={`dki-legende dki-legende-${L.name}`}>
          <span><i class="lg-aus"></i>noch nicht dabei</span>
          <span><i class="lg-an"></i>eingebaut</span>
          <span><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#2f7d4f" /><path d="M4.5 8.3l2.3 2.3 4.7-5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>gebaut und abgehakt</span>
        </div>
      </div>
    </div>
  ))}
</section>

<style>
  .dki{--bg:#f5f4ee; --tinte:#1d2742; --text2:#4a5168; --aus:#a3a8b8; --aus-text:#5d6478; --box:#fffefa; --box2:#f1eee1; --rahmen:#eceadd; --orange:#ff8a4c; --gruen:#2f7d4f; --marker:#ffe36e;
    border:2px solid var(--tinte); border-radius:14px; overflow:hidden; background:var(--bg); margin:0 0 28px}
  :global(:root[data-theme="dark"]) .dki{--bg:#131a2b; --tinte:#e9ecf5; --text2:#b3bad0; --aus:#4a5577; --aus-text:#8a93ad; --box:#1b2338; --box2:#222b45; --rahmen:#18203a; --marker:#8a7420}
  @media (prefers-color-scheme: dark){ :global(:root:not([data-theme="light"])) .dki{--bg:#131a2b; --tinte:#e9ecf5; --text2:#b3bad0; --aus:#4a5577; --aus-text:#8a93ad; --box:#1b2338; --box2:#222b45; --rahmen:#18203a; --marker:#8a7420} }
  .dki-desk,.dki-phone{position:relative; width:100%; overflow:hidden}
  .dki-phone{display:none}
  @media (max-width:640px){ .dki-desk{display:none} .dki-phone{display:block} }
  .dki-buehne{position:absolute; left:0; top:0; transform-origin:0 0; transform:scale(var(--s,1)); color:var(--tinte); font-family:var(--text)}
  .dki-buehne > *{position:absolute}
  .dki-rahmen{box-sizing:border-box; border:1.5px dashed var(--aus); transition:background .3s, border-color .3s}
  .dki-rahmen:global(.an),.dki-rahmen:global(.fertig){border:1.5px solid var(--tinte); background:var(--rahmen)}
  .dki-linie{overflow:visible; fill:none; stroke:var(--aus); stroke-width:1.5; stroke-dasharray:5 5; stroke-linecap:round}
  .dki-linie:global(.an),.dki-linie:global(.fertig){stroke:var(--tinte); stroke-width:2; stroke-dasharray:none}
  .dki-el{box-sizing:border-box; display:flex; align-items:center; gap:8px; padding:0 10px; font-size:12.5px; line-height:1.3; border:1.5px dashed var(--aus); color:var(--aus-text); transition:border-color .3s, color .3s}
  .dki-el b{font-family:var(--display); font-size:14.5px; font-weight:700; letter-spacing:-.01em}
  .dki-kern b{font-size:17px}
  .dki-eng{padding:0 8px 0 7px; gap:5px}
  .dki-eng b{font-size:13.5px}
  .dki-unter{color:inherit}
  .dki-chip{justify-content:center; gap:6px; padding:0 8px; text-align:center; font-family:var(--display); font-weight:600; line-height:1.2}
  .dki-el :global(.dki-ico){display:block; flex:none}
  .dki-ecke{display:none; position:absolute; top:-1.5px; right:-1.5px; width:14px; height:14px; clip-path:polygon(0 0,100% 100%,0 100%)}
  .dki-chip .dki-ecke{width:9px; height:9px}
  .dki-el:global(.an),.dki-el:global(.fertig){border:1.5px solid var(--tinte); color:var(--tinte); background:linear-gradient(118deg,var(--box) 0 68%,var(--box2) 68% 100%); clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,0 100%); animation:dki-rein .4s cubic-bezier(.2,.9,.3,1.2)}
  .dki-chip:global(.an),.dki-chip:global(.fertig){background:var(--box); clip-path:polygon(0 0,calc(100% - 9px) 0,100% 9px,100% 100%,0 100%)}
  .dki-el:global(.an) .dki-unter,.dki-el:global(.fertig) .dki-unter{color:var(--text2)}
  .dki-el:global(.an) .dki-ecke{display:block; background:var(--orange)}
  .dki-el:global(.fertig) .dki-ecke{display:block; background:var(--gruen)}
  .dki-modell{display:inline-block; margin-top:4px; padding:2px 6px; background:var(--marker); color:var(--tinte)}
  .dki-haken{display:none; z-index:2}
  .dki-haken circle{fill:var(--gruen)} .dki-haken path{fill:none; stroke:#fff; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round}
  .dki-haken:global(.fertig){display:block; animation:dki-plopp .35s cubic-bezier(.2,.9,.3,1.6)}
  .dki-ori{width:96px; height:96px; z-index:1}
  .dki-ori img{width:96px; height:96px; vertical-align:top}
  .dki-titel{font-family:var(--display); font-size:28px; line-height:32px; font-weight:800; letter-spacing:-.02em; white-space:nowrap}
  .dki-stand,.dki-label{font-family:var(--hand); font-weight:600; color:var(--text2); white-space:nowrap}
  .dki-stand{font-size:22px; line-height:26px}
  .dki-label{font-size:20px; line-height:24px}
  .dki-legende{display:flex; gap:22px; font-size:12.5px; color:var(--text2); white-space:nowrap}
  .dki-legende span{display:flex; align-items:center; gap:8px}
  .dki-legende-desk{left:20px; top:364px}
  .dki-legende-phone{left:16px; top:840px; flex-direction:column; gap:8px}
  .lg-aus,.lg-an{display:inline-block; width:22px; height:14px; box-sizing:border-box}
  .lg-aus{border:1.5px dashed var(--aus)}
  .lg-an{border:1.5px solid var(--tinte); background:linear-gradient(225deg,var(--orange) 0 5px,var(--box) 5px)}
  @keyframes dki-rein{from{opacity:.3} to{opacity:1}}
  @keyframes dki-plopp{from{transform:scale(.4)} to{transform:scale(1)}}
  @media (prefers-reduced-motion:reduce){ .dki-el,.dki-haken{animation:none !important} }
</style>

<script>
  const passe = () => document.querySelectorAll<HTMLElement>('.dki-desk, .dki-phone').forEach((w) => {
    if (!w.offsetWidth) return;
    w.style.setProperty('--s', String(w.offsetWidth / +w.dataset.w!));
    (w.firstElementChild as HTMLElement).style.setProperty('--s', String(w.offsetWidth / +w.dataset.w!));
  });
  new ResizeObserver(passe).observe(document.querySelector('.dki')!);
  passe();
</script>
