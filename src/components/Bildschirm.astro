---
// Bildschirmfoto aus origami im Papier-Stil (Klebeband, Unterschrift in Handschrift)
interface Props { src: string; alt: string; text?: string; breit?: number }
const { src, alt, text, breit } = Astro.props;
---
<figure class="baustein bildschirm" style={breit ? `max-width:${breit}px` : undefined}>
  <a href={src} target="_blank" rel="noopener" aria-label={`${alt} (groß öffnen)`}><img src={src} alt={alt} loading="lazy" decoding="async" /></a>
  {text && <figcaption class="hand">{text}</figcaption>}
</figure>
<style>
  .bildschirm{padding:14px; margin-left:auto; margin-right:auto}
  .bildschirm img{display:block; width:100%; height:auto; border-radius:3px; border:1px solid var(--linie)}
  .bildschirm figcaption{margin:10px 4px 0; font-size:1.15rem; line-height:1.3}
</style>
