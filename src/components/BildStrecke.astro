---
// Weitere Bildschirmfotos zugeklappt, damit der Artikel kurz bleibt
interface Props { titel?: string; bilder: { src: string; alt: string; text?: string }[] }
const { titel = 'Mehr Bildschirmfotos', bilder } = Astro.props;
---
<details class="baustein bildstrecke">
  <summary class="bkopf">{titel} ({bilder.length})</summary>
  <div class="bkoerper bs-gitter">
    {bilder.map((b) => (
      <figure>
        <a href={b.src} target="_blank" rel="noopener" aria-label={`${b.alt} (groß öffnen)`}><img src={b.src} alt={b.alt} loading="lazy" decoding="async" /></a>
        {b.text && <figcaption class="hand">{b.text}</figcaption>}
      </figure>
    ))}
  </div>
</details>
<style>
  .bildstrecke summary{cursor:pointer; list-style:none}
  .bildstrecke summary::-webkit-details-marker{display:none}
  .bildstrecke summary::after{content:"+"; margin-left:auto; font-size:1.2rem}
  .bildstrecke[open] summary::after{content:"–"}
  .bs-gitter{display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:18px}
  .bs-gitter figure{margin:0}
  .bs-gitter img{display:block; width:100%; height:auto; border-radius:3px; border:1px solid var(--linie)}
  .bs-gitter figcaption{margin:8px 2px 0; font-size:1.05rem; line-height:1.25}
</style>
